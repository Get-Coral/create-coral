{
	"name": "create-coral",
	"version": "1.0.3",
	"description": "Scaffold a new Coral module from the official template.",
	"keywords": [
		"cli",
		"coral",
		"create",
		"docker",
		"generator",
		"jellyfin",
		"scaffold",
		"self-hosted",
		"starter",
		"template"
	],
	"homepage": "https://getcoral.dev",
	"bugs": {
		"url": "https://github.com/Get-Coral/create-coral/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Coral",
		"url": "https://getcoral.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Get-Coral/create-coral.git"
	},
	"bin": {
		"create-coral": "./dist/create-coral.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"typecheck": "tsc --noEmit",
		"check": "vp check && pnpm typecheck",
		"lint": "vp lint --fix",
		"format": "vp fmt",
		"prepublishOnly": "pnpm build",
		"test:smoke": "pnpm build && node scripts/smoke.mjs",
		"test:scaffold": "pnpm build && node scripts/smoke.mjs --full"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0"
	},
	"devDependencies": {
		"@get-coral/oxfmt-config": "^0.1.0",
		"@get-coral/oxlint-config": "^0.1.0",
		"@get-coral/tsconfig": "^0.2.0",
		"@types/node": "^24.5.2",
		"publint": "^0.3.25",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.32.1"
}
